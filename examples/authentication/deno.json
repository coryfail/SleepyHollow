{
  "imports": {
    "@sleepy-hollow/framework/routing": "../../core/routing/mod.ts",
    "@sleepy-hollow/framework/validation": "../../core/validation/mod.ts",
    "@sleepy-hollow/framework/security": "../../core/security/mod.ts",
    "@sleepy-hollow/framework/testing": "../../core/testing/mod.ts",
    "zod": "npm:zod@4.4.3"
  },
  "fmt": {
    "exclude": [
      "**/*.req.md"
    ]
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test --unstable-kv --allow-read --allow-write",
    "verify": "deno fmt --check . && deno lint . && deno task check && deno task test && deno run --allow-read .sleepyhollow/verify.ts"
  }
}
